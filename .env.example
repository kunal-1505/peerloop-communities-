# PostgreSQL connection URL. Create a database named peerloop first.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/peerloop
# Required: generate a long random value (e.g. openssl rand -base64 48)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
# Optional: this exact email receives admin role at registration. Keep unset until ready.
ADMIN_EMAIL=
# Set true for managed PostgreSQL providers that require SSL; certificate verification remains enabled.
PGSSL=false
